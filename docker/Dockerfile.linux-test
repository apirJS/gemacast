# Local Linux test environment for Gemacast.
#
# Mirrors the `Linux PC` CI leg (.github/workflows/ci.yml) so a Linux-only
# failure can be reproduced and fixed from a Windows or macOS workstation
# without pushing. Same base OS (ubuntu-22.04), same pinned Rust, and the same
# source-built PipeWire + WirePlumber pair — the versions are load-bearing, see
# the comments on each below.
#
# The source tree is deliberately NOT copied in. Mount it at run time instead
# (see docker/README.md): the expensive PipeWire/WirePlumber compile stays in a
# cached image layer, and editing a .rs file on the host does not invalidate it.
#
#   docker build -f docker/Dockerfile.linux-test -t gemacast-linux-test docker/
#
FROM ubuntu:22.04

# Non-interactive apt and a sane locale; tzdata otherwise blocks on a prompt.
ENV DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# System dependencies
# ---------------------------------------------------------------------------
# The first two lines are what a bare ubuntu:22.04 lacks but a GitHub runner has
# preinstalled (so CI never lists it): a compiler, curl, git, CA certs, and
# `cmake` — the vendored audiopus_sys builds Opus through the `cmake` crate on
# Linux, because a bare image has no libopus-dev for its pkg-config probe to
# find. Everything after is copied verbatim from the CI "Install Linux
# Dependencies" step — GTK/webkit are needed because `cargo test --workspace`
# includes the Tauri mobile crate, and meson/ninja build PipeWire below.
#
# `libsndfile1-dev` is load-bearing and its absence fails *silently*. PipeWire's
# meson build gates the `pw-cat` tool on finding sndfile via pkg-config: without
# it the configure summary reads `Build pw-cat tool: NO`, the build succeeds
# anyway, and four tests that shell out to `pw-cat` to push audio through the
# graph hit their `Err(e) => return` arm and report `ok` having asserted nothing
# (`test_desktop_capture_receives_audio`, `test_process_capture_end_to_end`,
# `test_multi_process_capture`, `test_linux_enumerate_pipewire_nodes` — measured:
# "Failed to spawn pw-cat (No such file or directory), skipping"). CI never lists
# the package because the runner image already carries it, which is why the flags
# below can match ci.yml byte-for-byte and still yield a different toolset.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl git ca-certificates libssl-dev cmake \
      libsndfile1-dev \
      libasound2-dev libgtk-3-dev libayatana-appindicator3-dev \
      libwebkit2gtk-4.1-dev librsvg2-dev patchelf libxdo-dev dbus-x11 clang \
      meson ninja-build pkg-config libudev-dev libdbus-1-dev python3-docutils \
      libglib2.0-dev liblua5.3-dev \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# PipeWire 1.2.7 (source)
# ---------------------------------------------------------------------------
# Ubuntu 22.04's apt only ships PipeWire 0.3.48 headers; pipewire-rs 0.10 needs
# 1.x. Flags match CI exactly — every optional subsystem is disabled because the
# tests only need the core daemon, and `-Dsession-managers=[]` keeps PipeWire
# from pulling its own so the pinned WirePlumber below is the only one present.
ARG PW_VERSION=1.2.7
RUN curl -fsSL --retry 3 --retry-delay 5 \
      "https://github.com/PipeWire/pipewire/archive/refs/tags/${PW_VERSION}.tar.gz" | tar xz \
    && cd "pipewire-${PW_VERSION}" \
    && meson setup builddir --prefix=/usr \
      -Dpipewire-v4l2=disabled -Dpipewire-jack=disabled \
      -Dpipewire-alsa=disabled -Dlibjack-path="" -Dalsa=disabled \
      -Dsession-managers=[] -Dtests=disabled -Dexamples=disabled -Dman=disabled \
      -Ddocs=disabled -Dgstreamer=disabled -Dbluez5=disabled -Davahi=disabled \
      -Draop=disabled -Dudevrulesdir="" \
    && ninja -C builddir \
    && ninja -C builddir install \
    && ldconfig \
    && if ! command -v pw-cat >/dev/null; then \
         echo "FATAL: pw-cat was not built (libsndfile1-dev missing at configure time)" >&2; \
         exit 1; \
       fi \
    && cd .. && rm -rf "pipewire-${PW_VERSION}"

# ---------------------------------------------------------------------------
# WirePlumber 0.5.15 (source)
# ---------------------------------------------------------------------------
# Required for session management (node routing, pw-cat sink connections) that
# some tests depend on. Must be source-built against the same ABI: apt's 0.4.8
# was built against PipeWire 0.3.48 and spams "impl_ext_end_proxy called from
# wrong context" forever when paired with a 1.2.7 daemon.
ARG WP_VERSION=0.5.15
RUN curl -fsSL --retry 3 --retry-delay 5 \
      "https://github.com/PipeWire/wireplumber/archive/refs/tags/${WP_VERSION}.tar.gz" | tar xz \
    && cd "wireplumber-${WP_VERSION}" \
    && meson setup builddir --prefix=/usr \
      -Dtests=false -Ddoc=disabled -Dintrospection=disabled -Dsystem-lua=true \
    && ninja -C builddir \
    && ninja -C builddir install \
    && ldconfig \
    && cd .. && rm -rf "wireplumber-${WP_VERSION}"

# ---------------------------------------------------------------------------
# Rust — pinned to match rust-toolchain.toml
# ---------------------------------------------------------------------------
# Keep RUST_VERSION in step with rust-toolchain.toml's `channel`; a mismatch
# means the mounted toolchain file triggers a fresh download on first cargo run.
ARG RUST_VERSION=1.97.1
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
      sh -s -- -y --no-modify-path \
        --default-toolchain "${RUST_VERSION}" \
        --profile minimal \
        --component clippy,rustfmt

# ---------------------------------------------------------------------------
# cargo-audit — stands in for CI's `audit` job
# ---------------------------------------------------------------------------
# CI runs `rustsec/audit-check@v2`, a thin action wrapper around cargo-audit
# against the same RustSec advisory DB, so `cargo audit` is the faithful local
# equivalent. The action tracks cargo-audit's latest release rather than pinning
# one, so this deliberately does not pin either — a pin here would drift from
# what CI actually reports. `--locked` still fixes cargo-audit's own dependency
# tree at build time. Installed after the toolchain so it does not invalidate the
# PipeWire/WirePlumber layers above.
RUN cargo install cargo-audit --locked

# ---------------------------------------------------------------------------
# Bun — pinned to match the `frontend` CI job
# ---------------------------------------------------------------------------
# ci.yml pins bun 1.3.14 via oven-sh/setup-bun; a version drift here would test
# a different resolver than CI uses. `unzip` is what bun's install script needs
# to unpack its release, and it gets its own apt call on purpose: folding it into
# the big install above would invalidate the two source-build layers and cost a
# ~10 min PipeWire/WirePlumber recompile on every unrelated edit.
ARG BUN_VERSION=1.3.14
RUN apt-get update && apt-get install -y --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://bun.sh/install | bash -s "bun-v${BUN_VERSION}" \
    && mv /root/.bun/bin/bun /usr/local/bin/bun \
    && rm -rf /root/.bun \
    && test "$(bun --version)" = "${BUN_VERSION}"

# Build into an image-local dir, never the mounted tree. The host's target/
# holds Windows/MSVC artifacts; sharing it would thrash the cache at best and
# confuse the linker at worst. Mount a named volume here to persist the cache.
ENV CARGO_TARGET_DIR=/target
RUN mkdir -p /target

WORKDIR /work

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
COPY ci.sh /usr/local/bin/ci.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh /usr/local/bin/ci.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["ci.sh"]
