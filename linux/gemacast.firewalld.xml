<?xml version="1.0" encoding="utf-8"?>
<!--
  firewalld service for Gemacast (PC streamer).

  Opens the three ports that must accept inbound LAN traffic so a phone on the
  same network (Wi-Fi or USB/RNDIS tether — both look like LAN) can discover and
  stream from this PC.

  ADB transports (TCP 23557/23558) are intentionally absent: they run over
  loopback via `adb reverse` and need no firewall rule.
-->
<service>
  <short>Gemacast</short>
  <description>Gemacast PC audio streaming: LAN discovery (UDP 23555), audio (UDP 23556), and the TLS control channel (TCP 23559).</description>
  <port protocol="udp" port="23555"/>
  <port protocol="udp" port="23556"/>
  <port protocol="tcp" port="23559"/>
</service>
