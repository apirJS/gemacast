<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    WiX v4 MSI installer for Gemacast.
    Provides install, upgrade, repair, and clean uninstall support.
    UI flow is defined in CustomUI.wxs.

    UpgradeCode preserved from the old cargo-wix MSI for upgrade compatibility.
  -->

  <Package Name="Gemacast"
           Manufacturer="Echa Apriliyanto"
           Version="$(var.Version)"
           UpgradeCode="6D490F3C-E477-4FC8-ABF4-71D7CFEA7B53"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Public property for desktop shortcut toggle -->
    <Property Id="CREATEDESKTOPSHORTCUT" Value="1" Secure="yes" />

    <!-- Reinstall where the user put us last time. Without this, an upgrade - including
         the in-app self-update - silently relocates a custom install back to the default
         folder and abandons the old copy. AppSearch (50) reads this well before
         RemoveExistingProducts (1501) deletes it. -->
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="RememberedInstallFolder"
                      Root="HKLM"
                      Key="Software\EchaApriliyanto\Gemacast"
                      Name="InstallDir"
                      Type="raw"
                      Bitness="always64" />
    </Property>

    <!-- Public so a silent install can pick the parent folder the same way the browse
         dialog does: msiexec /i ... INSTALLROOT="D:\Program Files". Secure="yes" is
         what lets it cross into the elevated execute sequence. -->
    <Property Id="INSTALLROOT" Secure="yes" />

    <!-- ===== UI Configuration ===== -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.IconDir)\LICENSE.rtf" />

    <Property Id="LAUNCHAPP" Value="1" />
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]gemacast-pc.exe&quot;" Execute="immediate" Impersonate="yes" Return="asyncNoWait" />

    <!-- Kill the app before uninstallation or upgrade to prevent FilesInUse errors.
         Order matters: gemacast-pc has to die first. Its ADB watchdog runs
         `adb devices` every 3 seconds and that starts the server back up, so
         killing adb first only brings it straight back. -->
    <util:CloseApplication Id="CloseGemacast" Target="gemacast-pc.exe" Sequence="1" CloseMessage="yes" PromptToContinue="no" RebootPrompt="no" TerminateProcess="5" />
    <util:CloseApplication Id="CloseAdb" Target="adb.exe" Sequence="2" CloseMessage="no" PromptToContinue="no" RebootPrompt="no" TerminateProcess="3" />

    <!-- Don't let MSI hand the close over to Restart Manager. RM runs at
         InstallValidate, before we are allowed to terminate anything, and it cannot
         close either process anyway - the tray app ignores WM_QUERYENDSESSION and
         adb has no window at all. It just raised MsiRMFilesInUse and then reported
         it had failed. With RM off, the terminate below does the work instead. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

    <!-- Forcefully delete ANY firewall rules associated with the executable on uninstall (catches Windows Defender auto-generated rules).
         netsh is invoked directly rather than through cmd.exe /c: no shell feature is used, and one fewer process means one fewer
         chance of a console window. Return="ignore" already tolerates "no rules matched". -->
    <CustomAction Id="RemoveFirewallRules" Directory="INSTALLFOLDER" ExeCommand="[SystemFolder]netsh.exe advfirewall firewall delete rule name=all program=&quot;[INSTALLFOLDER]gemacast-pc.exe&quot;" Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- Exclude 23555-23559 from ephemeral allocation, so Windows cannot hand one of our
         ports to another program's outbound socket and leave us unable to bind. The block
         is already below the 49152 default, so this only matters where the dynamic range
         was widened downward. Same deferred/no-impersonate shape as above to stay
         window-free; Return="ignore" tolerates an exclusion that already exists. -->
    <CustomAction Id="ReservePortsTcp" Directory="INSTALLFOLDER" ExeCommand="[SystemFolder]netsh.exe int ipv4 add excludedportrange protocol=tcp startport=23555 numberofports=5 store=persistent" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="ReservePortsUdp" Directory="INSTALLFOLDER" ExeCommand="[SystemFolder]netsh.exe int ipv4 add excludedportrange protocol=udp startport=23555 numberofports=5 store=persistent" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="UnreservePortsTcp" Directory="INSTALLFOLDER" ExeCommand="[SystemFolder]netsh.exe int ipv4 delete excludedportrange protocol=tcp startport=23555 numberofports=5 store=persistent" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="UnreservePortsUdp" Directory="INSTALLFOLDER" ExeCommand="[SystemFolder]netsh.exe int ipv4 delete excludedportrange protocol=udp startport=23555 numberofports=5 store=persistent" Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <!-- Util schedules this before InstallFiles (4000) by default, which is too late
           on uninstall - RemoveFiles is 3500, so the files are already queued for
           deletion by then. It cannot move before InstallValidate either: the
           immediate action always schedules a deferred half, and scheduling one
           outside InstallInitialize..InstallFinalize is error 2762. So it goes here -
           inside the transaction, ahead of every file operation in the script. Util's
           row is virtual, so "override" replaces it instead of clashing with it. The
           _X64 suffix tracks InstallerPlatform in msi.wixproj. -->
      <Custom Action="override Wix4CloseApplications_X64" After="InstallInitialize" />
      <Custom Action="RemoveFirewallRules" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <!-- Last, so nothing is still bound in the range netsh has to exclude. -->
      <Custom Action="ReservePortsTcp" Before="InstallFinalize" Condition="NOT REMOVE" />
      <Custom Action="ReservePortsUdp" After="ReservePortsTcp" Condition="NOT REMOVE" />
      <Custom Action="UnreservePortsTcp" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="UnreservePortsUdp" After="UnreservePortsTcp" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- Reference our custom WixUI sequence from CustomUI.wxs -->
    <UIRef Id="WixUI_InstallDir_Custom" />

    <!-- ===== Directory Structure ===== -->

    <!-- INSTALLROOT is the parent the user picks; Name="." makes it resolve to its own
         parent. The browse dialog retargets INSTALLROOT (see CustomUI.wxs), so the
         Gemacast folder is always created inside the chosen location instead of being
         replaced by it. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLROOT" Name=".">
        <Directory Id="INSTALLFOLDER" Name="Gemacast" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Gemacast" />
    </StandardDirectory>

    <!-- ===== Application Files ===== -->

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <!-- Main executable with firewall exception -->
      <Component Id="MainExecutable" Guid="*">
        <File Id="GemacastExe"
              Source="$(var.SourceDir)\gemacast-pc.exe"
              KeyPath="yes">
          <fire:FirewallException Id="GemacastFirewallTcp"
                                  Name="Gemacast (TCP)"
                                  Description="Allow Gemacast inbound TCP for audio streaming"
                                  Protocol="tcp"
                                  Scope="any"
                                  Profile="all" />
          <fire:FirewallException Id="GemacastFirewallUdp"
                                  Name="Gemacast (UDP)"
                                  Description="Allow Gemacast inbound UDP for device discovery"
                                  Protocol="udp"
                                  Scope="any"
                                  Profile="all" />
        </File>
      </Component>

      <!-- ADB binaries -->
      <Component Id="AdbExe" Guid="*">
        <File Id="adb_exe"
              Source="$(var.SourceDir)\adb.exe"
              KeyPath="yes" />
      </Component>

      <Component Id="AdbWinApi" Guid="*">
        <File Id="adbwinapi_dll"
              Source="$(var.SourceDir)\AdbWinApi.dll"
              KeyPath="yes" />
      </Component>

      <Component Id="AdbWinUsbApi" Guid="*">
        <File Id="adbwinusbapi_dll"
              Source="$(var.SourceDir)\AdbWinUsbApi.dll"
              KeyPath="yes" />
      </Component>

      <!-- Clean up leftover bin/ folder from previous installations -->
      <Component Id="CleanupBinFolder" Guid="*">
        <RemoveFolder Id="RemoveBinDir" Directory="BinSubfolder" On="both" />
        <RegistryValue Root="HKCU"
                       Key="Software\EchaApriliyanto\Gemacast"
                       Name="BinCleanup"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Remove INSTALLFOLDER on uninstall (catches runtime-created files) -->
      <Component Id="CleanupInstallFolder" Guid="*">
        <RemoveFolder Id="RemoveInstallDir" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\EchaApriliyanto\Gemacast"
                       Name="InstallDirCleanup"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Clean up the registry key tree on uninstall -->
      <Component Id="CleanupRegistry" Guid="*">
        <RegistryValue Root="HKCU"
                       Key="Software\EchaApriliyanto\Gemacast"
                       Name="Installed"
                       Type="integer" Value="1" KeyPath="yes" />
        <!-- HKLM, not HKCU: a per-machine install must not remember its location per-user.
             Read back by the RememberedInstallFolder search above. -->
        <RegistryValue Root="HKLM"
                       Key="Software\EchaApriliyanto\Gemacast"
                       Name="InstallDir"
                       Type="string" Value="[INSTALLFOLDER]" />
        <RemoveRegistryKey Id="RemoveGemacastKey" Root="HKCU" Key="Software\EchaApriliyanto\Gemacast" Action="removeOnUninstall" />
        <RemoveRegistryKey Id="RemoveVendorKey" Root="HKCU" Key="Software\EchaApriliyanto" Action="removeOnUninstall" />
        <RemoveRegistryKey Id="RemoveGemacastKeyMachine" Root="HKLM" Key="Software\EchaApriliyanto\Gemacast" Action="removeOnUninstall" />
        <RemoveRegistryKey Id="RemoveVendorKeyMachine" Root="HKLM" Key="Software\EchaApriliyanto" Action="removeOnUninstall" />
      </Component>

    </ComponentGroup>

    <DirectoryRef Id="INSTALLFOLDER">
      <Directory Id="BinSubfolder" Name="bin" />
    </DirectoryRef>

    <!-- ===== Start Menu Shortcut (always installed) ===== -->

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="AppStartMenuShortcut"
                  Name="Gemacast"
                  Description="Low-latency real-time audio streaming from PC to Android"
                  Target="[INSTALLFOLDER]gemacast-pc.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ProductICO" />
        <RemoveFolder Id="CleanStartMenu" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\EchaApriliyanto\Gemacast"
                       Name="StartMenuInstalled"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ===== Desktop Shortcut (conditional) ===== -->

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*" Condition="CREATEDESKTOPSHORTCUT = 1">
        <Shortcut Id="AppDesktopShortcut"
                  Name="Gemacast"
                  Description="Low-latency real-time audio streaming from PC to Android"
                  Target="[INSTALLFOLDER]gemacast-pc.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ProductICO" />
        <RemoveFile Id="CleanDesktopShortcut" Name="Gemacast.lnk" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\EchaApriliyanto\Gemacast"
                       Name="DesktopInstalled"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- ===== Features ===== -->

    <Feature Id="Main" Title="Gemacast" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- ===== Add/Remove Programs ===== -->

    <Icon Id="ProductICO" SourceFile="$(var.IconDir)\Product.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductICO" />
    <Property Id="ARPHELPLINK" Value="https://github.com/apirJS/gemacast" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/apirJS/gemacast" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/apirJS/gemacast/releases" />
    <!-- Hide Modify button — single-feature installer, nothing to modify -->
    <Property Id="ARPNOMODIFY" Value="1" />

  </Package>

</Wix>
